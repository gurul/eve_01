{
  "name": "eve-link-chat-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Eve Link chat: OpenUI message list rendered inside the app's WKWebView. Built into ../App/ChatWeb.",
  "scripts": {
    "build": "vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "gen-prompt": "node scripts/gen-prompt.mjs",
    "check-prompt": "node scripts/gen-prompt.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
