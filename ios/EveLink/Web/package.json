{
  "name": "eve-link-chat-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "eve lite's browser chat (OpenUI and json-render cards), built into the bridge's web_lite. Also the source of eve's card catalog, which the native iPhone app's Swift catalog is generated from.",
  "scripts": {
    "build:web": "vite build --config vite.web.config.ts",
    "gen-prompt": "node scripts/gen-prompt.mjs",
    "check-prompt": "node scripts/gen-prompt.mjs --check",
    "gen-json-prompt": "node scripts/gen-json-prompt.mjs",
    "check-json-prompt": "node scripts/gen-json-prompt.mjs --check",
    "gen-swift-catalog": "node scripts/gen-swift-catalog.mjs",
    "check-swift-catalog": "node scripts/gen-swift-catalog.mjs --check",
    "gen-card-fixtures": "node scripts/gen-card-fixtures.mjs",
    "check-card-fixtures": "node scripts/gen-card-fixtures.mjs --check",
    "validate-spec": "node scripts/validate-spec.mjs",
    "preview-cards": "vite --host 127.0.0.1 --port 5199 --open /preview.html",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@json-render/core": "0.23.1",
    "@json-render/react": "0.23.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
